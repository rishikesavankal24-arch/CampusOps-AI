# ==============================================================================
# CampusOps AI — Backend Environment Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to `backend/.env`:
#      cp .env.example .env
# 2. Fill in the required credentials and configuration values below.
# 3. NEVER commit `backend/.env` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings [REQUIRED]
# ------------------------------------------------------------------------------
APP_NAME=CampusOps AI
APP_VERSION=0.1.0
DEBUG=true

# Comma-separated list of allowed CORS origins (frontend client URL)
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL + pgvector Database Configuration [REQUIRED]
# ------------------------------------------------------------------------------
# Port 5434 maps to the dedicated CampusOps PostgreSQL container (isolated from other projects)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=campusops_db
POSTGRES_USER=campusops_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Async Database URL for FastAPI (SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://campusops_admin:your_secure_postgres_password_here@localhost:5434/campusops_db

# Sync Database URL for Alembic database migrations (SQLAlchemy + psycopg)
SYNC_DATABASE_URL=postgresql+psycopg://campusops_admin:your_secure_postgres_password_here@localhost:5434/campusops_db

# ------------------------------------------------------------------------------
# 3. JWT Authentication & Security [REQUIRED]
# ------------------------------------------------------------------------------
# Cryptographic secret key for signing session JWT tokens.
# In development, a fallback is provided. In production (DEBUG=false), this MUST
# be a unique, cryptographically random string of at least 32 characters.
JWT_SECRET_KEY=your_secure_random_jwt_secret_at_least_32_chars_long_2026

# Token signing algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Access token lifespan in minutes (default: 60 minutes = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 / Identity Services [OPTIONAL for email login; REQUIRED for Google SSO]
# ------------------------------------------------------------------------------
# OAuth 2.0 Web Client ID generated in Google Cloud Console.
# Used on the backend to verify the audience of Google ID tokens.
# Must match `NEXT_PUBLIC_GOOGLE_CLIENT_ID` in `frontend/.env.local`.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. Google Gemini API & RAG Settings [REQUIRED for AI Chatbot & Retrieval]
# ------------------------------------------------------------------------------
# API Key obtained from Google AI Studio (https://aistudio.google.com/).
# Kept strictly server-side on the backend. NEVER expose to frontend or git.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini generative and embedding models
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FALLBACK=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768

# RAG Retrieval tuning parameters
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100
