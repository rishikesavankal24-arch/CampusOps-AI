# ==============================================================================
# CampusOps AI — Monorepo Root Environment Template (.env.example)
# ==============================================================================
# Master reference for all environment variables used across CampusOps AI.
# Each subproject reads from its dedicated local configuration file:
#   - Backend:  `backend/.env`
#   - Frontend: `frontend/.env.local`
#   - Docker:   `docker-compose.yml` (reads environment overrides or defaults)
#
# NEVER commit real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Application Settings [REQUIRED]
# ------------------------------------------------------------------------------
APP_NAME=CampusOps AI
APP_VERSION=0.1.0
DEBUG=false
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL + pgvector on dedicated port 5434) [REQUIRED]
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=campusops_db
POSTGRES_USER=campusops_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here

DATABASE_URL=postgresql+asyncpg://campusops_admin:your_secure_postgres_password_here@localhost:5434/campusops_db
SYNC_DATABASE_URL=postgresql+psycopg://campusops_admin:your_secure_postgres_password_here@localhost:5434/campusops_db

# ------------------------------------------------------------------------------
# 3. JWT Authentication & Security [REQUIRED]
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=your_secure_random_jwt_secret_at_least_32_chars_long_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 / Identity Services [OPTIONAL for email login; REQUIRED for Google SSO]
# ------------------------------------------------------------------------------
# Backend token audience validation
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend Google Sign-In button rendering (browser-safe, must match GOOGLE_CLIENT_ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. Google Gemini API [REQUIRED for AI Incident Analysis & RAG Agent Orchestration]
# ------------------------------------------------------------------------------
# Server-side only. Used in `backend/.env`. NEVER add to frontend!
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 6. Frontend Networking [REQUIRED]
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
FASTAPI_INTERNAL_URL=http://localhost:8000
