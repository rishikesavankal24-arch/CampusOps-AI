# ==============================================================================
# CampusOps AI — Frontend Environment Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to `frontend/.env.local`:
#      cp .env.example .env.local
# 2. Fill in the values below.
# 3. NEVER commit `frontend/.env.local` to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Connectivity Settings [REQUIRED]
# ------------------------------------------------------------------------------
# Public API URL accessible from the client browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal backend URL used by Next.js BFF server route handlers (/api/auth/*)
FASTAPI_INTERNAL_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. Google Identity Services SSO [OPTIONAL for email login; REQUIRED for Google SSO]
# ------------------------------------------------------------------------------
# OAuth 2.0 Web Client ID generated in Google Cloud Console.
# Browser-safe client ID used to render the Google Sign-In button.
# Must match `GOOGLE_CLIENT_ID` in `backend/.env`.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# SECURITY NOTICE:
# - NEVER add GEMINI_API_KEY to this file or any frontend configuration.
# - NEVER add JWT_SECRET_KEY, database passwords, or private keys to frontend.
# - All sensitive credentials must remain exclusively in `backend/.env`.
# ------------------------------------------------------------------------------
